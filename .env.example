# ──────────────────────────────────────────────────────────────────────────
# Shubalekha — environment variables
# Copy to `.env.local` and fill in. All values are validated at boot by
# src/lib/env.ts (the app refuses to start with missing/invalid required vars).
# ──────────────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────────────
# Apex domain used for subdomain routing. Local dev: use "localhost:3000".
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
# Full origin of the app (used for callbacks, emails, canonical URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# "development" | "production"  (usually set by the platform)
NODE_ENV="development"

# ── Auth.js / NextAuth (v5) ──────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-32+-char-random-string"
# Trust the host header (needed for subdomain/proxy setups & local dev).
AUTH_TRUST_HOST="true"
# Google OAuth — https://console.cloud.google.com → Credentials → OAuth client.
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Mongoose (app models) AND the Auth.js MongoDB adapter share this connection.
MONGODB_URI="mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/shubalekha?retryWrites=true&w=majority"
MONGODB_DB="shubalekha"

# ── Upstash Redis (rate-limiting, caching, slug locks, analytics buffer) ──────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Resend (transactional email + magic-link sign-in) ────────────────────────
RESEND_API_KEY=""
# Verified sender, e.g. "Shubalekha <hello@shubalekha.com>"
EMAIL_FROM="Shubalekha <onboarding@resend.dev>"

# ── Object storage (S3-compatible / Cloudflare R2) — used from Phase 8 ────────
STORAGE_PROVIDER="r2"                 # r2 | s3
STORAGE_BUCKET=""
STORAGE_ACCOUNT_ID=""                 # R2 account id
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION="auto"
# Public base URL that serves uploaded files via CDN.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""

# ── Cron (lifecycle job) ─────────────────────────────────────────────────────
# Shared secret required in the Authorization header to call /api/cron/lifecycle.
CRON_SECRET="replace-with-a-random-string"

# ── Sentry (optional in dev; wired in Phase 12) ──────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
